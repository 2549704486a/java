BUSINESS_API_BASE_URL=http://127.0.0.1:8088
BUSINESS_API_TIMEOUT_SECONDS=3
BUSINESS_API_MAX_RETRIES=2

# 模型密钥只能写入本地 .env，不要提交到 Git。
# OpenAI 官方接口可保持 LLM_BASE_URL 为空；兼容接口则填写服务商提供的地址。
LLM_API_KEY=replace-me
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

AGENT_HOST=127.0.0.1
AGENT_PORT=8090
AGENT_CACHE_SIZE=128
AGENT_SESSION_CACHE_SIZE=1024
EXCHANGE_CONFIRMATION_TTL_SECONDS=120
EXCHANGE_CONFIRMATION_CAPACITY=10000
AGENT_LOG_LEVEL=INFO
AGENT_LOG_FILE=
