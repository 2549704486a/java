BUSINESS_API_BASE_URL=http://127.0.0.1:8088
BUSINESS_API_TIMEOUT_SECONDS=3
BUSINESS_API_MAX_RETRIES=2

# 模型密钥只能写入本地 .env，不要提交到 Git。
# OpenAI 官方接口可保持 LLM_BASE_URL 为空；兼容接口则填写服务商提供的地址。
LLM_API_KEY=replace-me
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# RAG 离线构建使用独立配置；未填写时可以复用 LLM 的兼容接口和密钥。
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_MODEL=
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=60
RAG_INDEX_DIR=knowledge/index
RAG_COLLECTION_NAME=incentive-business-rules
RAG_ENABLED=false
RAG_RELEVANCE_THRESHOLD=0.30
RAG_TOP_K=3

AGENT_HOST=127.0.0.1
AGENT_PORT=8090
AGENT_CACHE_SIZE=128
AGENT_SESSION_CACHE_SIZE=1024
# 至少 32 个随机字符。生产环境应由密钥管理系统注入，不能提交真实值。
AGENT_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
AGENT_AUTH_ISSUER=incentive-agent
AGENT_AUTH_AUDIENCE=incentive-agent-web
AGENT_ACCESS_TOKEN_TTL_SECONDS=3600
EXCHANGE_CONFIRMATION_TTL_SECONDS=120
EXCHANGE_CONFIRMATION_CAPACITY=10000
EXCHANGE_CONFIRMATION_STORE=redis
EXCHANGE_CONFIRMATION_REDIS_URL=redis://127.0.0.1:6379/0
EXCHANGE_CONFIRMATION_REDIS_PREFIX=agent:exchange:confirmation
EXCHANGE_CONFIRMATION_RETENTION_SECONDS=3600
AGENT_LOG_LEVEL=INFO
AGENT_LOG_FILE=
